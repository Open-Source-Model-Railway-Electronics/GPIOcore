{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "update io",
            "type": "shell",
            "command": "updateIO.py",
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "python3 ./src/build.py",
            "problemMatcher": []
        },
        {
            "label": "upload",
            "type": "shell",
            "command": "python3 ./src/upload.py",
            "problemMatcher": []
        },
        {
            "label": "release new version",
            "type": "shell",
            "command": "python3 release.py",
            "problemMatcher": []
        },
        {
            "label": "initialize git repository",
            "type": "shell",
            "command": "python3 initGit.py",
            "problemMatcher": []
        },
        {
            "label": "Open monitor",
            "type": "shell",
            "command": "arduino-cli.exe monitor -p COM4 -c baudrate=115200",
            "problemMatcher": []
        }
    ]
}